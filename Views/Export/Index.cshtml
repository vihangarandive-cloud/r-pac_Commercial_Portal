@{
    ViewBag.Title = "Export Portal";
    ViewBag.ActiveModule = "Export";
}

<div class="row justify-content-center align-items-center mt-4">
    <div class="col-lg-8 text-center">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-dark text-white p-5 position-relative" 
             style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;">
            
            <!-- Glow Accent -->
            <div class="position-absolute top-0 start-50 translate-middle bg-danger bg-opacity-25 blur-3xl rounded-circle" 
                 style="width: 250px; height: 250px; filter: blur(80px); pointer-events: none;"></div>
            
            <div class="card-body py-5 position-relative z-1">
                <div class="mb-4 d-inline-flex p-4 bg-danger bg-opacity-10 text-danger rounded-circle animate-pulse" 
                     style="border: 2px dashed rgba(225, 29, 72, 0.3);">
                    <i class="bi bi-airplane-engines fs-1"></i>
                </div>
                
                <h2 class="fw-black mb-2 tracking-tight uppercase" style="font-weight: 800; font-size: 2.2rem;">
                    Export Portal <span class="text-danger">Coming Soon</span>
                </h2>
                <p class="text-white-50 max-w-md mx-auto mb-5 fw-medium">
                    We are currently building the comprehensive export tracking module for the r-pac Commercial department. This module will integrate commercial export invoices, shipping bills, customs documents, and container tracking details.
                </p>

                <!-- Features Preview Grid -->
                <div class="row g-4 text-start justify-content-center mb-5">
                    <div class="col-md-5">
                        <div class="d-flex gap-3 p-3 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10">
                            <div class="text-danger mt-1">
                                <i class="bi bi-patch-check-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-white">Full 17-Step Export Chronology</h6>
                                <p class="text-white-50 x-small mb-0">Track all export milestones from booking confirmations to harbor/airline custom clearances.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="d-flex gap-3 p-3 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10">
                            <div class="text-danger mt-1">
                                <i class="bi bi-patch-check-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-white">Multi-Agent Attachment Vault</h6>
                                <p class="text-white-50 x-small mb-0">Secure storage for Bill of Ladings, Air Waybills, and custom clearing drafts.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="d-flex gap-3 p-3 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10">
                            <div class="text-danger mt-1">
                                <i class="bi bi-patch-check-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-white">Interactive Export Analytics</h6>
                                <p class="text-white-50 x-small mb-0">Compare import vs export ratios, shipping weights (CBM/Kg), and total transport expenses.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="d-flex gap-3 p-3 rounded-4 bg-white bg-opacity-5 border border-white border-opacity-10">
                            <div class="text-danger mt-1">
                                <i class="bi bi-patch-check-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-1 text-white">Automatic Outlook Dispatch</h6>
                                <p class="text-white-50 x-small mb-0">Morning email digests automatically aggregate both import approvals and export bookings.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a href="@Url.Action("Index", "Dashboard")" class="btn btn-light rounded-3 px-4 py-2.5 fw-bold text-dark hover-shadow transition-all">
                        <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                    </a>
                    <button class="btn btn-rpac-red rounded-3 px-4 py-2.5 fw-bold text-white hover-shadow transition-all" 
                            onclick="Swal.fire({title: 'Notification Subscribed', text: 'You will be notified once the export portal goes live!', icon: 'success'})">
                        <i class="bi bi-bell-fill me-1"></i> Notify Me When Ready
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
