@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Rpac Commercial Portal</title>
    <link rel="icon" type="image/png" href="@Url.Content("~/Content/images/logo.png")">

    <!-- Google Fonts - Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at center, #172f65 0%, #081125 100%);
            background-color: #081125;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 1.5rem;
            overflow: hidden;
        }

        .login-card {
            background: #ffffff;
            border-radius: 2.2rem;
            width: 100%;
            max-width: 440px;
            padding: 3.5rem 3rem;
            box-shadow: 0 25px 50px -12px rgba(8, 20, 43, 0.45);
            animation: slideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .logo-container {
            margin-bottom: 1rem;
            text-align: center;
        }

        .logo-container img {
            height: 100px;
            width: auto;
            margin-bottom: 1rem;
        }

        .title-primary {
            font-weight: 850;
            font-size: 1.4rem;
            color: #0b1936;
            letter-spacing: -0.02em;
            text-transform: uppercase;
            margin-bottom: 0.3rem;
        }

        .title-secondary {
            font-weight: 700;
            font-size: 0.72rem;
            color: #8c9bb2;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 0;
        }

        .form-label {
            color: #64748b;
            font-weight: 700;
            font-size: 0.725rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            display: block;
        }

        .form-control {
            background-color: #f8fafc;
            border: 1.5px solid #e2e8f0;
            color: #0f172a;
            border-radius: 1.15rem;
            padding: 0.9rem 1.2rem;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.2s ease-in-out;
        }

        .form-control::placeholder {
            color: #94a3b8;
            font-weight: 500;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #e11d48;
            box-shadow: 0 0 0 4px rgba(225, 29, 72, 0.12);
            color: #0f172a;
            outline: none;
        }

        .btn-rpac-red {
            background-color: #e11d48;
            color: #ffffff;
            font-weight: 800;
            font-size: 0.9rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            border-radius: 1.15rem;
            padding: 0.95rem;
            border: none;
            transition: all 0.2s ease-in-out;
            box-shadow: 0 10px 20px -5px rgba(225, 29, 72, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4rem;
            width: 100%;
        }

        .btn-rpac-red:hover {
            background-color: #be123c;
            transform: translateY(-1px);
            box-shadow: 0 12px 22px rgba(225, 29, 72, 0.45);
            color: #ffffff;
        }

        .btn-rpac-red:active {
            transform: translateY(1px);
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-container">
            <img src="data:image/png;base64," alt="RPAC Logo">
            <h4 class="title-primary">Commercial Portal</h4>
            <p class="title-secondary">R-PAC PRINTCARE LANKA</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 rounded-4 py-2.5 px-3 mb-4 d-flex align-items-center gap-2" style="background-color: #fef2f2; border: 1.5px solid #fee2e2 !important; color: #dc2626;">
                <i class="bi bi-exclamation-circle-fill"></i>
                <span class="small fw-semibold">@ViewBag.Error</span>
            </div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="username" class="form-label">USERNAME</label>
                <input type="text" class="form-control" id="username" name="username" placeholder="Unique User ID" required autofocus>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">PASSWORD</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Required" required>
            </div>

            <button type="submit" class="btn btn-rpac-red">
                LOG IN &nbsp;<i class="bi bi-box-arrow-in-right" style="font-size: 1.05rem;"></i>
            </button>
        }
    </div>

</body>
</html>
