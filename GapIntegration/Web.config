<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />

    <!--
      The parent SO-GEN site declares:
         <modules runAllManagedModulesForAllRequests="true" />
         <handlers><add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." ... /></handlers>
      A child application inherits both. Because path="*." also matches
      extension-less URLs, /gap/api/start-job is claimed by ASP.NET MVC and never
      reaches the Python process: the page (default document) opens, but every
      fetch()/EventSource call fails. Clearing the inherited handler list fixes it.
      (Remove the <clear /> if this app runs as its own IIS site, not as a
      sub-application of SO-GEN.)
    -->
    <handlers>
      <clear />
      <!-- AspNetCoreModuleV2 = ANCM shipped with the ASP.NET Core Hosting Bundle
           2.2+ / 3.x+ / 5+. If the server only has the old v1 module, IIS answers
           500.19 ("AspNetCoreModuleV2" is not a native module) and you must either
           install the Hosting Bundle or change this back to "AspNetCoreModule". -->
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <!-- Out-of-process ANCM. stdoutLogFile is the first place to look when IIS
         reports 500.30 / 502.3 instead of an application error. IIS appends
         _<pid>_<date> to the name, so the real file is logs\python_<pid>_<date>.log
         (there is usually no file called exactly "python.log").
         processPath is relative to THIS folder: venv must exist here and must
         have been created on this machine with `pip install -r requirements.txt`
         (a venv copied from another PC points at a base interpreter that does
         not exist here -> 500.30 before a single line of Python runs). -->
    <aspNetCore processPath=".\venv\Scripts\python.exe"
                arguments="-m uvicorn app:app --host 127.0.0.1 --port %ASPNETCORE_PORT%"
                hostingModel="OutOfProcess"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\python.log"
                startupTimeLimit="120"
                shutdownTimeLimit="30"
                processesPerApplication="1">
      <environmentVariables>
        <environmentVariable name="PORT" value="%ASPNETCORE_PORT%" />
        <!-- Virtual path of the IIS application: /gap -> "gap". Empty at the site root. -->
        <environmentVariable name="GAP_BASE_PATH" value="gap" />
        <environmentVariable name="GAP_LOG_LEVEL" value="INFO" />
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </aspNetCore>

    <!-- Show the app's own error text instead of IIS's generic error page. -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Never serve the credentials file or the sources. -->
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".py" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>

  <system.web>
    <identity impersonate="false" />
    <!-- The SO-GEN Forms-auth cookie must not apply to this application. -->
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
</configuration>
