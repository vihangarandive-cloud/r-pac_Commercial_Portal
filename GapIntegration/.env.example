# Copy this file to .env (next to auth.py) and fill in the password.
# .env is git-ignored on purpose - that is why a fresh deployment to the
# SO-GEN server starts with GAP_PASSWORD unset and every dropdown fails.
GAP_USERNAME=GAP0012
GAP_PASSWORD=your_password_here

# --- only needed when hosted as an IIS sub-application under SO-GEN ---------
# Virtual path of the IIS application, e.g. /gap -> GAP_BASE_PATH=gap
# GAP_BASE_PATH=gap

# --- optional tuning -------------------------------------------------------
# GAP_CONNECT_TIMEOUT=10
# GAP_READ_TIMEOUT=90
# GAP_LOG_LEVEL=INFO

# Which to-job payload to send first when adding a PO to the cart.
# Leave unset (auto) unless the log says one of them was accepted:
#   auto          - try the UI values, then the PO head, then the resolved ids
#   as-sent       - exactly what the page posts (productGenderId="BOYS", ...)
#   po-head       - gender/type/season/franchise/coo taken from gap-po-item-head
#   resolved-ids  - dropdown text resolved to ids through the lookup APIs
# GAP_PAYLOAD_VARIANT=po-head
